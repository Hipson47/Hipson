{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hipson Task Flow Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "checks",
    "builder",
    "reviewer"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "objective": {
      "type": "string",
      "pattern": "\\S"
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project": {
      "type": "string",
      "pattern": "\\S"
    },
    "lead": {
      "type": "string",
      "pattern": "\\S"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "command",
        "scope"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "pattern": "\\S"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "observe": {
          "type": "boolean"
        },
        "checkpoint": {
          "type": "boolean"
        },
        "env": {
          "type": "string",
          "enum": [
            "inherit",
            "minimal"
          ]
        },
        "env_allow": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "command"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "pattern": "\\S"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "observe": {
          "type": "boolean"
        },
        "env": {
          "type": "string",
          "enum": [
            "inherit",
            "minimal"
          ]
        },
        "env_allow": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "max_repairs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "close_to": {
      "type": "string",
      "enum": [
        "review",
        "done"
      ]
    },
    "check_timeout": {
      "type": "number",
      "minimum": 1,
      "maximum": 86400
    },
    "protected": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  }
}
