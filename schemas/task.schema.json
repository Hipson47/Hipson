{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hipson Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_kind", "schema_version", "id", "project", "title", "objective", "acceptance", "status", "lead", "created_at", "updated_at", "revision"],
  "properties": {
    "artifact_kind": { "const": "hipson.task" },
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^T-[0-9]{4,}$" },
    "project": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "acceptance": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["open", "in_progress", "blocked", "review", "done", "cancelled"] },
    "lead": { "type": "string", "minLength": 1, "description": "Recorded lead label, not an authenticated identity." },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "revision": { "type": "integer", "minimum": 1 },
    "assignments": { "type": "array", "items": { "$ref": "#/$defs/assignment" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" }, "description": "Open findings only; use task.findings for resolved history." },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["freshness", "passing", "reasons", "accepted", "latest", "current", "untrusted_fields"],
      "properties": {
        "freshness": {"enum": ["missing", "current", "stale", "failing", "unknown"]},
        "passing": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "accepted": {"type": ["string", "null"], "pattern": "^V-[0-9a-f]{32}$"},
        "latest": {"$ref": "#/$defs/verification"},
        "current": {"$ref": "#/$defs/project_state"},
        "untrusted_fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assignment", "path"],
        "properties": {
          "assignment": { "type": "string", "pattern": "^A-[0-9]{4,}$" },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "project_state": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "subject", "fingerprint", "dirty", "error"],
      "properties": {
        "revision": {"type": "string", "pattern": "^(none|[0-9a-f]{40}|[0-9a-f]{64})$"},
        "subject": {"type": ["string", "null"], "maxLength": 1024},
        "fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "dirty": {"type": ["boolean", "null"]},
        "error": {"type": ["string", "null"], "maxLength": 1024},
        "files": {"type": "array", "items": {"$ref": "#/$defs/verification_file"}},
        "generated_files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification_file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "state", "index", "tracked"],
      "properties": {
        "path": {"type": "string"},
        "state": {"type": "string", "pattern": "^(missing|[0-9]{6}:[0-9a-f]{64})$"},
        "index": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "tracked": {"type": "boolean"}
      }
    },
    "verification": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["id", "task", "label", "command", "exit_code", "duration_seconds", "started_at", "finished_at", "revision", "subject", "fingerprint", "dirty", "error", "state_changed", "builder_finished_seq", "output_tail", "untrusted_fields"],
      "properties": {
        "id": {"type": "string", "pattern": "^V-[0-9a-f]{32}$"},
        "task": {"type": "string", "pattern": "^T-[0-9]{4,}$"},
        "label": {"type": "string", "maxLength": 1024},
        "command": {"type": "array", "items": {"type": "string", "maxLength": 4096}},
        "exit_code": {"type": "integer"},
        "duration_seconds": {"type": "number", "minimum": 0},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "revision": {"type": "string", "pattern": "^(none|[0-9a-f]{40}|[0-9a-f]{64})$"},
        "subject": {"type": ["string", "null"], "maxLength": 1024},
        "fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "dirty": {"type": ["boolean", "null"]},
        "error": {"type": ["string", "null"], "maxLength": 1024},
        "files": {"type": "array", "items": {"$ref": "#/$defs/verification_file"}},
        "generated_files": {"type": "array", "items": {"type": "string"}},
        "changes": {"type": "array", "items": {"type": "string"}},
        "cleanup_confirmed": {"type": "boolean"},
        "state_changed": {"type": "boolean"},
        "builder_finished_seq": {"type": "integer", "minimum": 0},
        "output_tail": {"type": "string", "maxLength": 8192},
        "untrusted_fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task", "actor", "role", "mode", "scope", "status", "started_at", "ended_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^A-[0-9]{4,}$" },
        "task": { "type": "string", "pattern": "^T-[0-9]{4,}$" },
        "actor": { "type": "string", "minLength": 1, "description": "Worker label recorded by the lead, not an authenticated identity." },
        "role": { "enum": ["builder", "reviewer", "explorer", "researcher"] },
        "mode": { "enum": ["ro", "rw"] },
        "scope": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "status": { "enum": ["active", "passed", "failed", "cancelled"] },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": ["string", "null"], "format": "date-time" },
        "owner_pid": { "type": ["integer", "null"], "minimum": 1, "maximum": 2147483647 },
        "owner_boot_id": { "type": ["string", "null"], "minLength": 1 },
        "owner_host": { "type": ["string", "null"], "minLength": 1 },
        "owner_pid_namespace": { "type": ["string", "null"], "minLength": 1 },
        "lease_until": { "type": ["string", "null"], "format": "date-time" },
        "result": { "$ref": "#/$defs/result" },
        "activity": { "$ref": "#/$defs/activity" },
        "failure_journal": { "$ref": "#/$defs/journal" },
        "acknowledged_at": { "type": ["string", "null"], "format": "date-time" },
        "ack_note": { "type": "string", "maxLength": 1024 },
        "ack_state": { "enum": ["not_required", "unacknowledged", "acknowledged"] }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["timestamp", "source", "text"],
      "properties": {
        "timestamp": {"type": "string"},
        "source": {"enum": ["stdout", "stderr", "progress"]},
        "text": {"type": "string", "maxLength": 1024}
      }
    },
    "activity": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["heartbeat_at", "last_stdout", "last_stderr", "progress", "observations", "untrusted_fields"],
      "properties": {
        "heartbeat_at": {"type": "string"},
        "last_stdout": {"type": "string", "maxLength": 1024},
        "last_stderr": {"type": "string", "maxLength": 1024},
        "progress": {"type": "string", "maxLength": 1024},
        "observations": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/observation"}},
        "untrusted_fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "journal": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["result_state", "exit_code", "signal", "duration_seconds", "changed_files", "diff_stat", "log_tail", "reason", "uncertainty"],
      "properties": {
        "result_state": {"enum": ["none", "rejected", "valid"]},
        "exit_code": {"type": ["integer", "null"]},
        "signal": {"type": ["integer", "null"]},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "changed_files": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 1024}},
        "diff_stat": {"type": "string", "maxLength": 8192},
        "log_tail": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/observation"}},
        "reason": {"type": "string", "maxLength": 1024},
        "uncertainty": {"type": "string", "maxLength": 1024}
      }
    },
    "result": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status", "summary", "files_changed", "commands", "findings", "risks"],
      "properties": {
        "status": {"type": "string", "enum": ["completed", "partial", "blocked"]},
        "summary": {"type": "string"},
        "files_changed": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "change"], "properties": {"path": {"type": "string"}, "change": {"type": "string"}}}},
        "commands": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["command", "exit_code"], "properties": {"command": {"type": "string"}, "exit_code": {"type": ["integer", "null"]}}}},
        "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["severity", "title", "detail", "location"], "properties": {"severity": {"type": "string", "enum": ["blocking", "major", "minor", "info"]}, "title": {"type": "string", "pattern": "\\S"}, "detail": {"type": "string"}, "location": {"type": ["string", "null"]}}}},
        "risks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task", "source_assignment", "severity", "title", "detail", "location", "status", "resolved_by_assignment", "resolution_note", "created_at", "updated_at", "resolved_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^F-[0-9]{4,}$"},
        "task": {"type": "string", "pattern": "^T-[0-9]{4,}$"},
        "source_assignment": {"type": ["string", "null"], "pattern": "^A-[0-9]{4,}$"},
        "severity": {"enum": ["blocking", "major", "minor", "info"]},
        "title": {"type": "string"},
        "detail": {"type": "string"},
        "location": {"type": "string"},
        "status": {"enum": ["open", "fixed", "wontfix", "duplicate"]},
        "resolved_by_assignment": {"type": ["string", "null"], "pattern": "^A-[0-9]{4,}$"},
        "resolution_note": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "resolved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
