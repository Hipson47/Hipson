{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hipson Quality Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "artifact_kind",
    "schema_version",
    "created_at_utc",
    "work_id",
    "task",
    "ok",
    "quality_gate",
    "verification_gate",
    "sidecar_eval_gate",
    "human_decision_gate",
    "release_claim_gate",
    "gates",
    "verification_status",
    "sidecar_present",
    "decision",
    "summary",
    "verified_findings",
    "advisory_findings",
    "finding_adjudication",
    "rejected_or_unverified",
    "required_local_checks"
  ],
  "properties": {
    "artifact_kind": { "const": "hipson.quality_report" },
    "schema_version": { "type": "string" },
    "created_at_utc": { "type": "string" },
    "work_id": { "type": "string" },
    "task": { "type": "string" },
    "ok": { "type": "boolean" },
    "quality_gate": { "type": "string" },
    "verification_gate": { "type": "string" },
    "sidecar_eval_gate": { "type": "string" },
    "human_decision_gate": { "type": "string" },
    "release_claim_gate": { "type": "string" },
    "gates": {
      "type": "object",
      "required": ["verification_gate", "sidecar_eval_gate", "human_decision_gate", "release_claim_gate"],
      "properties": {
        "verification_gate": { "type": "string" },
        "sidecar_eval_gate": { "type": "string" },
        "human_decision_gate": { "type": "string" },
        "release_claim_gate": { "type": "string" }
      }
    },
    "verification_status": { "type": "string" },
    "sidecar_present": { "type": "boolean" },
    "decision": { "type": "string" },
    "summary": { "type": "string" },
    "verified_findings": { "type": "array" },
    "advisory_findings": { "type": "array" },
    "finding_adjudication": { "type": "array" },
    "rejected_or_unverified": { "type": "array" },
    "required_local_checks": { "type": "array" }
  }
}
