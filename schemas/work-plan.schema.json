{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hipson Work Plan",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "artifact_kind",
    "schema_version",
    "work_id",
    "created_at_utc",
    "task",
    "project",
    "repo_state",
    "route",
    "scan",
    "changed_files",
    "discovered_commands",
    "selected_skills",
    "packet",
    "packet_preflight",
    "ai_quality",
    "verification",
    "memory",
    "audit",
    "next_actions"
  ],
  "properties": {
    "artifact_kind": { "const": "hipson.work_plan" },
    "schema_version": { "type": "string" },
    "work_id": { "type": "string" },
    "created_at_utc": { "type": "string" },
    "task": { "type": "string" },
    "project": { "type": "string" },
    "repo_state": { "type": "object" },
    "route": { "type": "object" },
    "scan": { "type": "string" },
    "changed_files": { "type": "array" },
    "discovered_commands": { "type": "array" },
    "selected_skills": { "type": "array" },
    "packet": { "type": "object" },
    "packet_preflight": { "type": "object" },
    "ai_quality": { "type": "object" },
    "verification": { "type": "array" },
    "memory": { "type": "array" },
    "audit": { "type": "array" },
    "next_actions": { "type": "array" }
  }
}
