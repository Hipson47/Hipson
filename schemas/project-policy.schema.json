{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hipson Project Policy",
  "type": "object",
  "additionalProperties": true,
  "required": ["artifact_kind", "schema_version", "project", "path", "policy", "valid", "issues", "warnings"],
  "properties": {
    "artifact_kind": { "const": "hipson.project_policy" },
    "schema_version": { "type": "string" },
    "project": { "type": "string" },
    "path": { "type": "string" },
    "policy": {
      "type": "object",
      "required": [
        "default_workflow",
        "denied_paths",
        "allowed_paths",
        "prompt_required_operations",
        "local_only",
        "release_gates",
        "agent_integration"
      ],
      "properties": {
        "default_workflow": { "type": "string" },
        "denied_paths": { "type": "array" },
        "allowed_paths": { "type": "array" },
        "prompt_required_operations": { "type": "array" },
        "local_only": { "type": "boolean" },
        "release_gates": { "type": "array" },
        "agent_integration": { "type": "object" },
        "observe_changes": { "type": "boolean", "description": "Opt-in post-run change observation for hipson task run" },
        "observe_max_files": { "type": "integer", "minimum": 1 },
        "observe_max_bytes": { "type": "integer", "minimum": 1 },
        "worker_env": { "enum": ["inherit", "minimal"], "description": "Worker environment for hipson task run (default inherit)" },
        "worker_env_allow": { "type": "array", "items": { "type": "string" }, "maxItems": 64,
                              "description": "Extra variable names passed to workers under worker_env minimal" }
      }
    },
    "valid": { "type": "boolean" },
    "issues": { "type": "array" },
    "warnings": { "type": "array" }
  }
}
