{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hipson Packet Preflight",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "artifact_kind",
    "schema_version",
    "created_at_utc",
    "ok",
    "path",
    "size_chars",
    "max_chars",
    "sha256",
    "redaction_policy",
    "errors",
    "warnings",
    "cautions"
  ],
  "properties": {
    "artifact_kind": { "const": "hipson.packet_preflight" },
    "schema_version": { "type": "string" },
    "created_at_utc": { "type": "string" },
    "ok": { "type": "boolean" },
    "path": { "type": "string" },
    "size_chars": { "type": "integer" },
    "max_chars": { "type": "integer" },
    "sha256": { "type": "string" },
    "redaction_policy": { "type": "string" },
    "errors": { "type": "array" },
    "warnings": { "type": "array" },
    "cautions": { "type": "array" }
  }
}
